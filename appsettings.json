{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitoring": {
    "PingIntervalSeconds": 1,
    "DetailsIntervalSeconds": 20,
    "PingTimeoutMilliseconds": 1000,
    "MetricsTimeoutSeconds": 60,
    "MaxConcurrentChecks": 4,
    "HistoryRetentionDays": 7
  }
}
